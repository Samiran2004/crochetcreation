# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=crochetcreation

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Brevo Mail Configuration
BREVO_API_KEY=your_brevo_api_key_here
SENDER_EMAIL=crochetcreation@samiransamanta.in

# Media storage: "cloudinary" (default) or "r2".
# Flip to r2 once the values below are filled in; flip back any time —
# assets already uploaded keep working either way.
STORAGE_BACKEND=cloudinary
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's custom domain. Never the r2.dev address: Cloudflare
# rate-limits that one and does not support it for production traffic.
R2_PUBLIC_BASE_URL=https://cdn.crochetcreation.online
